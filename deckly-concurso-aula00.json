      "createdAt": "2026-10-14T13:07:00.000Z",
      "updatedAt": "2026-10-14T13:07:00.000Z"
    },
    {
      "id": "ort-20",
      "deckId": "deck-ortografia-aula00",
      "front": "(Pref. Cariacica/2020) Qual NÃO tem dígrafo consonantal: esquecer, trabalhar, sorriso ou principalmente?",
      "back": "Principalmente. Ela tem o encontro consonantal PR e o dígrafo nasal EN, mas nenhum dígrafo consonantal. As outras têm QU, LH e RR.",
      "dueAt": "2026-10-14T13:07:00.000Z",
      "intervalDays": 0,
      "intervalMinutes": 0,
      "easeFactor": 2.5,
