    },
    {
      "id": "ort-06",
      "deckId": "deck-ortografia-aula00",
      "front": "Monossílabos átonos",
      "back": "Não têm autonomia fonética e se apoiam em outra palavra. Em geral são artigos, preposições, conjunções e pronomes oblíquos: de, sem, em, a, com, por.",
      "dueAt": "2026-10-14T13:07:00.000Z",
      "intervalDays": 0,
      "intervalMinutes": 0,
      "easeFactor": 2.5,
      "repetitions": 0,
