      "updatedAt": "2026-10-14T13:07:00.000Z"
    },
    {
      "id": "ort-18",
      "deckId": "deck-ortografia-aula00",
      "front": "O que é encontro consonantal?",
      "back": "Sequência de dois fonemas consonantais, cada letra com seu som. Ex.: brado, claro, transtorno.",
      "dueAt": "2026-10-14T13:07:00.000Z",
      "intervalDays": 0,
      "intervalMinutes": 0,
      "easeFactor": 2.5,
      "repetitions": 0,
