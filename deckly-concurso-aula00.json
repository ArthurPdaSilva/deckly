    },
    {
      "id": "ort-21",
      "deckId": "deck-ortografia-aula00",
      "front": "(ALEPI/2020) Em distinguir, extinguir e adquirir, o \"u\" é pronunciado?",
      "back": "Não, porque GU e QU são dígrafos.",
      "dueAt": "2026-10-14T13:07:00.000Z",
