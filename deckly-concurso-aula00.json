    },
    {
      "id": "ort-05",
      "deckId": "deck-ortografia-aula00",
      "front": "Monossílabos tônicos",
      "back": "Têm autonomia fonética e são pronunciados com mais intensidade: meu, pé, seu, pó, dor.",
      "dueAt": "2026-10-14T13:07:00.000Z",
      "intervalDays": 0,
      "intervalMinutes": 0,
      "easeFactor": 2.5,
      "repetitions": 0,
