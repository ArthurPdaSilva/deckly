    },
    {
      "id": "ort-07",
      "deckId": "deck-ortografia-aula00",
      "front": "Qual a finalidade da acentuação (muito cobrada)?",
      "back": "Diferenciar palavras, podendo mudar a classe gramatical. Sabia (verbo), sabiá (substantivo), sábia (adjetivo). Acumulo (verbo), acúmulo (substantivo).",
      "dueAt": "2026-10-14T13:07:00.000Z",
      "intervalDays": 0,
      "intervalMinutes": 0,
      "easeFactor": 2.5,
