    },
    {
      "id": "ort-19",
      "deckId": "deck-ortografia-aula00",
      "front": "O encontro consonantal pode ficar onde, na divisão silábica?",
      "back": "Na mesma sílaba: CLI-MA, FLO-RES, PSI-CO-SE, LE-TRA, PSEU-DÔ-NI-MO. Em sílabas diferentes: AD-VEN-TO, OB-TU-SO, FÚC-SIA, ÉT-NI-CO.",
      "dueAt": "2026-10-14T13:07:00.000Z",
      "intervalDays": 0,
      "intervalMinutes": 0,
      "easeFactor": 2.5,
      "repetitions": 0,
