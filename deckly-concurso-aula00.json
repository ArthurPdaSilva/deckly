    },
    {
      "id": "ort-22",
      "deckId": "deck-ortografia-aula00",
      "front": "O que é ditongo?",
      "back": "Encontro de uma vogal e uma semivogal na mesma sílaba (sv+V ou V+sv). Ex.: glória, sai, meu, céu, gíria.",
      "dueAt": "2026-10-14T13:07:00.000Z",
      "intervalDays": 0,
      "intervalMinutes": 0,
      "easeFactor": 2.5,
      "repetitions": 0,
