    {
      "id": "ort-03",
      "deckId": "deck-ortografia-aula00",
      "front": "Sílaba tônica x sílaba átona",
      "back": "Tônica é pronunciada com mais força (acento tônico). Átona é pronunciada com menos força. Em \"saci\", a tônica é a última sílaba.",
      "dueAt": "2026-10-14T13:07:00.000Z",
