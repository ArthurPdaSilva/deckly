      "schedulerAlgorithm": "fsrs",
      "createdAt": "2026-10-14T13:07:00.000Z",
      "updatedAt": "2026-10-14T13:07:00.000Z"
    },
    {
      "id": "ort-16",
      "deckId": "deck-ortografia-aula00",
      "front": "Palavra com dígrafo: fonemas x letras?",
      "back": "Terá menos fonemas do que letras.",
      "dueAt": "2026-10-14T13:07:00.000Z",
      "intervalDays": 0,
      "intervalMinutes": 0,
      "easeFactor": 2.5,
      "repetitions": 0,
