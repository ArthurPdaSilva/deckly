    },
    {
      "id": "ort-08",
      "deckId": "deck-ortografia-aula00",
      "front": "Acento agudo x circunflexo (timbre)",
      "back": "Agudo marca timbre aberto. Circunflexo marca timbre fechado. Avó (aberto), avô (fechado).",
      "dueAt": "2026-10-14T13:07:00.000Z",
      "intervalDays": 0,
      "intervalMinutes": 0,
      "easeFactor": 2.5,
