    },
    {
      "id": "ort-17",
      "deckId": "deck-ortografia-aula00",
      "front": "Regra básica da sílaba",
      "back": "Cada sílaba tem uma vogal. PA-ÍS tem duas vogais, uma em cada sílaba, então é hiato. PAIS tem uma vogal e o \"i\" é semivogal, então é ditongo de uma sílaba.",
      "dueAt": "2026-10-14T13:07:00.000Z",
      "intervalDays": 0,
      "intervalMinutes": 0,
      "easeFactor": 2.5,
      "repetitions": 0,
