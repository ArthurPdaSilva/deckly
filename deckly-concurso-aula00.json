    },
    {
      "id": "ort-23",
      "deckId": "deck-ortografia-aula00",
      "front": "Ditongo crescente",
      "back": "Semivogal + vogal, e a vogal (mais forte) vem depois. Ex.: história, primário, série, água, enquanto, cinquenta.",
      "dueAt": "2026-10-14T13:07:00.000Z",
      "intervalDays": 0,
      "intervalMinutes": 0,
      "easeFactor": 2.5,
