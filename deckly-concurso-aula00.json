      "createdAt": "2026-10-14T13:07:00.000Z",
      "updatedAt": "2026-10-14T13:07:00.000Z"
    },
    {
      "id": "ort-15",
      "deckId": "deck-ortografia-aula00",
      "front": "Dígrafos de vogais nasais",
      "back": "AM/AN (campo, canto), EM/EN (tempo, vento), IM/IN (limbo, lindo), OM/ON (ombro, onda), UM/UN (tumba, tunda).",
      "dueAt": "2026-10-14T13:07:00.000Z",
      "intervalDays": 0,
      "intervalMinutes": 0,
      "easeFactor": 2.5,
