    },
    {
      "id": "ort-04",
      "deckId": "deck-ortografia-aula00",
      "front": "Acento tônico x acento gráfico",
      "back": "Tônico ocorre na fala. Gráfico ocorre na escrita. Nem sempre andam juntos: \"saci\" tem só tônico, \"café\" tem os dois.",
      "dueAt": "2026-10-14T13:07:00.000Z",
      "intervalDays": 0,
      "intervalMinutes": 0,
      "easeFactor": 2.5,
